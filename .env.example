# Copy this file to ".env" and fill in your own values. Never share or upload the .env file.

PORT=3000
# The public address of your site (used for payment redirects). Local: http://localhost:3000
BASE_URL=http://localhost:3000
# Set to "production" on your live server
NODE_ENV=development
# Set to 1 when the site is behind a proxy such as Nginx, Render or Railway
TRUST_PROXY=0

# Admin dashboard login at /admin. Use a real password of at least 10 characters.
ADMIN_PASSWORD=change-this-password
# Long random string that signs admin logins. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-secret

# Database file. On a host with a persistent disk, point this at the disk (for example /var/data/ambi.db)
DB_PATH=./data/ambi.db
# Put sample products and projects in the database on first run. Set to false to start empty.
SEED_SAMPLES=true

# Contact details shown on the website. SITE_WA is digits only with country code, e.g. 2348012345678
SITE_WA=
SITE_PHONE=+234 800 000 0000
SITE_EMAIL=hello@your-domain.com
SITE_ADDRESS=Your workshop address, City
SITE_HOURS=Mon-Fri 8:00am-6:00pm · Sat 9:00am-4:00pm

# Optional: email alerts for every new order and enquiry
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AMBI TECH <no-reply@your-domain.com>

# Optional: let customers pay online with Paystack (leave empty to take orders by WhatsApp only)
PAYSTACK_SECRET_KEY=
